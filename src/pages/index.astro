          <li data-reveal class="flex gap-3">
            <span class="grid place-items-center w-9 h-9 shrink-0 rounded-lg bg-teal-wash text-teal-dark">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.1c0-1.22-.02-2.78-1.7-2.78-1.7 0-1.95 1.32-1.95 2.69V21h-4z" /></svg>
            </span>
            <a href="https://www.linkedin.com/company/the-public-service-desk/" target="_blank" rel="noopener noreferrer" class="font-semibold text-navy hover:text-teal-dark self-center">Follow us on LinkedIn</a>
          </li>
        </ul>
      </div>

      <div data-reveal class="rounded-2xl border border-line bg-white p-6 sm:p-8 shadow-[0_24px_60px_-28px_rgba(15,23,42,0.2)]">
