---
import Layout from '../layouts/Layout.astro';
import Doodle from '../components/Doodle.astro';
import Squiggle from '../components/Squiggle.astro';

const stages = [
  { n: '01', title: 'Ideation', body: 'We explore your challenges and opportunities together, identifying where AI can make the biggest impact.', icon: 'bulb' },
  { n: '02', title: 'Design', body: 'We co-design a solution tailored to your workflows, capacity, and goals.', icon: 'pen' },
  { n: '03', title: 'Build', body: 'Our team builds the AI application side-by-side with your staff — no black boxes, no handoffs.', icon: 'code' },
  { n: '04', title: 'Implementation', body: 'We guide your team through launch, onboarding, and real-world deployment with confidence.', icon: 'rocket' },
  { n: '05', title: 'Ongoing Support', body: 'We stay with you — troubleshooting, updating, and evolving your solution as your needs grow.', icon: 'heart' },
];

const support = [
  { title: 'Troubleshooting & bug fixes', icon: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z' },
  { title: 'Feature updates & enhancements', icon: 'M12 3l1.9 5.8L20 10l-5 3.7L16.5 20 12 16.4 7.5 20 9 13.7 4 10l6.1-1.2z' },
  { title: 'Guidance on AI best practices', icon: 'M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.3h6c0-1 .4-1.8 1-2.3A7 7 0 0 0 12 2z' },
  { title: 'Long-term maintenance planning', icon: 'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z' },
];

const icons: Record<string, string> = {
  bulb: 'M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.3h6c0-1 .4-1.8 1-2.3A7 7 0 0 0 12 2z',
  pen: 'M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z',
  code: 'M16 18l6-6-6-6M8 6l-6 6 6 6',
  rocket: 'M4.5 16.5c-1.5 1.3-2 5-2 5s3.7-.5 5-2c.7-.8.7-2.1-.1-2.9a2.2 2.2 0 0 0-2.9-.1zM12 15l-3-3a22 22 0 0 1 2-3.9A12.9 12.9 0 0 1 22 2c0 2.7-.8 7.5-6 11a22.4 22.4 0 0 1-4 2zM9 12H4s.6-3 2-4c1.6-1.1 5 0 5 0M12 15v5s3-.6 4-2c1.1-1.6 0-5 0-5',
  heart: 'M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7z',
  app: 'M12 2l9 5v10l-9 5-9-5V7zM12 22V12M21 7l-9 5-9-5',
  school: 'M22 10L12 5 2 10l10 5 10-5zM6 12v5c3 3 9 3 12 0v-5',
  compass: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM16.2 7.8l-2.1 6.3-6.3 2.1 2.1-6.3z',
};
---

<Layout
  title="The Public Service Desk — AI for Nonprofits & Community Organizations"
  description="The Public Service Desk partners with nonprofits and community organizations to build, implement, and maintain AI applications — side-by-side, every step of the way."
>
  <!-- ───────────── Hero ───────────── -->
  <section id="top" class="relative pt-16 sm:pt-24 pb-10">
    <!-- doodles: desktop only, scattered around the headline -->
    <div class="hidden lg:block" aria-hidden="true">
      <Doodle name="bubble" label="AI?" class="absolute left-[7%] top-[15%] w-24 text-ink" rotate={-8} />
      <Doodle name="dash" class="absolute left-[4%] top-[40%] w-8" />
      <Doodle name="bulb" class="absolute left-[12%] top-[52%] w-20 text-ink" rotate={-12} />
      <Doodle name="gear" class="absolute right-[9%] top-[13%] w-16 text-ink" rotate={10} />
      <Doodle name="bubble" label="yes!" class="absolute right-[4%] top-[30%] w-28 text-ink" rotate={9} />
      <Doodle name="sparkle" class="absolute right-[15%] top-[52%] w-10" />
      <Doodle name="dash" class="absolute right-[6%] top-[62%] w-8" rotate={70} />
    </div>

    <div class="relative max-w-3xl mx-auto px-5 sm:px-6 text-center">
      <p data-reveal class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-3.5 py-1.5 text-xs font-semibold text-navy">
        <span class="w-1.5 h-1.5 rounded-full bg-teal"></span>
        Nonprofit Technology Partner
      </p>
      <p data-reveal class="mt-6 text-sm font-semibold tracking-wide uppercase text-subtle">The Public Service Desk</p>
      <h1 data-reveal class="mt-3 text-[2.6rem] leading-[1.05] sm:text-6xl sm:leading-[1.02] font-extrabold tracking-[-0.035em]">
        With your organization <Squiggle>every step</Squiggle> of the way.
      </h1>
      <p data-reveal class="mt-6 text-lg sm:text-xl font-medium leading-relaxed text-body/90 max-w-2xl mx-auto">
        We partner with nonprofits and community organizations to build, implement, and maintain AI applications — side-by-side, every step of the way.
      </p>
      <div data-reveal class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="#contact" class="inline-flex items-center gap-2 rounded-lg bg-navy hover:bg-navy-dark text-white font-semibold px-5 py-3 shadow-sm transition-colors">
          Contact Us
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href="#what-we-do" class="inline-flex items-center gap-2 rounded-lg px-5 py-3 font-semibold text-ink hover:bg-wash transition-colors">Learn More</a>
      </div>
      <p data-reveal class="mt-4 text-sm text-subtle">Austin, TX</p>
    </div>

    <!-- Product-style window: the full lifecycle at a glance -->
    <div data-reveal class="relative mt-14 max-w-5xl mx-auto px-5 sm:px-6">
      <div class="rounded-xl border border-line bg-white shadow-[0_24px_60px_-24px_rgba(15,23,42,0.18)] overflow-hidden">
        <div class="flex items-center gap-1.5 px-4 h-10 border-b border-line bg-wash">
          <span class="w-2.5 h-2.5 rounded-full bg-[#e2e1dc]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#e2e1dc]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#e2e1dc]"></span>
          <span class="ml-3 text-xs text-subtle truncate">Beyond the Build: Full-Lifecycle AI Support</span>
        </div>
        <div class="grid md:grid-cols-[1.1fr_1fr]">
          <div class="relative min-h-64 md:min-h-full">
            <img src="/images/hero-800x600.jpg" alt="Nonprofit team collaborating" class="absolute inset-0 w-full h-full object-cover" loading="eager" />
          </div>
          <div class="p-6 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-wide text-teal-dark">Our Process</p>
            <ol class="mt-4 space-y-1">
              {stages.map((s, i) => (
                <li class:list={['flex items-center gap-3 rounded-lg px-3 py-2.5', i === 4 ? 'bg-teal-wash' : '']}>
                  <span class:list={['grid place-items-center w-7 h-7 rounded-full text-xs font-bold', i === 4 ? 'bg-teal text-white' : 'bg-navy/8 text-navy']}>
                    {i < 4 ? (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg>
                    ) : s.n}
                  </span>
                  <span class:list={['font-semibold', i === 4 ? 'text-ink' : 'text-body']}>{s.title}</span>
                  {i === 4 && <span class="ml-auto w-2 h-2 rounded-full bg-teal animate-pulse" aria-hidden="true"></span>}
                </li>
              ))}
            </ol>
            <p class="mt-5 font-hand text-2xl text-navy leading-tight">We are always here for you.</p>
          </div>
        </div>
      </div>
    </div>

    <p data-reveal class="mt-10 px-5 text-center text-sm text-subtle flex items-center justify-center gap-2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-teal-dark"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" /><circle cx="12" cy="10" r="3" /></svg>
      Proudly serving nonprofits and community organizations in Austin, TX and beyond.
    </p>
  </section>

  <!-- ───────────── What We Do ───────────── -->
  <section id="what-we-do" class="py-20 sm:py-28">
    <div class="max-w-5xl mx-auto px-5 sm:px-6">
      <p data-reveal class="text-sm font-semibold text-teal-dark">What We Do</p>
      <h2 data-reveal class="mt-2 text-4xl sm:text-5xl font-extrabold tracking-[-0.03em]">The Solutions that <Squiggle>work</Squiggle></h2>

      <div class="mt-12 grid gap-5 md:grid-cols-2">
        <article data-reveal class="card-glow relative md:col-span-2 rounded-2xl p-7 sm:p-9 grid md:grid-cols-[1fr_auto] gap-8 items-center">
          <div>
            <svg class="text-teal-dark" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icons.app} /></svg>
            <h3 class="mt-4 text-2xl font-bold tracking-tight">AI App Development</h3>
            <p class="mt-3 max-w-2xl leading-relaxed">
              Got a great AI app idea for your non-profit or community work, but building it feels daunting? We're not just about talking AI, we build it with you. We will work side-by-side with you to craft and maintain an AI application tailored to your needs.
            </p>
            <a href="#contact" class="mt-6 inline-flex items-center gap-2 rounded-lg bg-teal hover:bg-teal-dark text-ink hover:text-white font-semibold px-4 py-2.5 text-sm transition-colors">
              Get Started
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
          </div>
          <Doodle name="wrench" class="hidden md:block w-28 text-ink" rotate={-6} />
        </article>

        <article data-reveal class="rounded-2xl border border-line bg-wash p-7 sm:p-8">
          <svg class="text-teal-dark" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icons.school} /></svg>
          <h3 class="mt-4 text-xl font-bold tracking-tight">Education and Training</h3>
          <p class="mt-3 leading-relaxed">
            Our training and education services are designed to empower individuals and organizations to become confident AI creators. Join us, and let's learn and build the future of AI, together! We're passionate about fostering a community of 'citizen developers' that can build a better future for technology.
          </p>
        </article>

        <article data-reveal class="rounded-2xl border border-line bg-wash p-7 sm:p-8">
          <svg class="text-teal-dark" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icons.compass} /></svg>
          <h3 class="mt-4 text-xl font-bold tracking-tight">Consulting</h3>
          <p class="mt-3 leading-relaxed">
            Are you curious about how AI could help your non-profit or community organization do better? Don't worry, we get it! From project management and guidance to community ideation. We are here to help you get the tools and opportunity needed to build an effective and maintainable AI application.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ───────────── Commitment quote ───────────── -->
  <section class="relative py-20 sm:py-24 bg-navy text-white overflow-hidden">
    <Doodle name="sparkle" class="absolute left-[8%] top-10 w-10 hidden sm:block" />
    <Doodle name="heart" class="absolute right-[7%] bottom-10 w-20 text-white/70 hidden sm:block" rotate={12} />
    <div class="relative max-w-4xl mx-auto px-5 sm:px-6 text-center">
      <p data-reveal class="text-sm font-semibold text-teal">Our Commitment</p>
      <blockquote data-reveal class="mt-4 text-3xl sm:text-5xl font-extrabold tracking-[-0.03em] leading-tight text-white">
        “Partnering with Nonprofits to Build &amp; Sustain Impactful AI”
      </blockquote>
      <p data-reveal class="mt-8 text-xl font-semibold text-white">Unlike most providers, we don't stop at implementation.</p>
      <p data-reveal class="mt-3 text-white/75 leading-relaxed max-w-2xl mx-auto">
        We are committed to your long-term success, offering dedicated support and maintenance services to ensure your AI solutions continue to deliver value.
      </p>
    </div>
  </section>

  <!-- ───────────── Beyond the Build ───────────── -->
  <section id="beyond-the-build" class="py-20 sm:py-28">
    <div class="max-w-5xl mx-auto px-5 sm:px-6 grid lg:grid-cols-[1.2fr_1fr] gap-12 items-center">
      <div>
        <p data-reveal class="text-sm font-semibold text-teal-dark">Our Commitment</p>
        <h2 data-reveal class="mt-2 text-4xl sm:text-5xl font-extrabold tracking-[-0.03em] leading-[1.05]">
          Beyond the Build: <span class="text-navy">Full-Lifecycle AI Support</span>
        </h2>
        <div class="mt-6 space-y-4 text-lg leading-relaxed">
          <p data-reveal>Most companies help organizations with only a few steps in the app development process. You typically get support for ideation, production, and implementation. But what happens after the project is "over"?</p>
          <p data-reveal>That's where The Public Service Desk is different. We're committed to empowering organizations like yours by providing support through the entire lifecycle of your application development and beyond.</p>
          <p data-reveal class="text-ink font-medium">We understand that successful AI creation and implementation isn't just about building a tool — it's about ensuring its long-term success and sustainability.</p>
        </div>
        <a data-reveal href="#contact" class="mt-8 inline-flex items-center gap-2 rounded-lg bg-navy hover:bg-navy-dark text-white font-semibold px-5 py-3 transition-colors">
          Work With Us
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
      <div data-reveal class="relative">
        <div class="rounded-2xl overflow-hidden border border-line">
          <img src="/images/714dedca25f5ddefa8fdba0a0fd9cba7.jpg" alt="Team working together on an AI project" class="w-full aspect-[4/3] object-cover" loading="lazy" />
        </div>
        <Doodle name="loop" class="absolute -bottom-12 -left-10 w-40 text-ink bg-white rounded-full p-2 hidden sm:block" rotate={-6} />
      </div>
    </div>
  </section>

  <!-- ───────────── Five stages ───────────── -->
  <section id="process" class="py-20 sm:py-28 bg-wash border-y border-line">
    <div class="max-w-6xl mx-auto px-5 sm:px-6">
      <div class="max-w-2xl">
        <p data-reveal class="text-sm font-semibold text-teal-dark">Our Process</p>
        <h2 data-reveal class="mt-2 text-4xl sm:text-5xl font-extrabold tracking-[-0.03em] leading-[1.05]">
          The <Squiggle>Five Stages</Squiggle> of AI Tool Development
        </h2>
      </div>

      <ol class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {stages.map((s, i) => (
          <li
            data-reveal
            class:list={[
              'relative rounded-2xl p-6 flex flex-col',
              i === 4 ? 'card-glow lg:-translate-y-3' : 'bg-white border border-line',
            ]}
          >
            <div class="flex items-center justify-between">
              <span class="font-hand text-3xl font-bold text-teal-dark">{s.n}</span>
              <svg class="text-navy" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icons[s.icon]} /></svg>
            </div>
            <h3 class="mt-4 text-lg font-bold tracking-tight">{s.title}</h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-subtle">{s.body}</p>
          </li>
        ))}
      </ol>

      <div data-reveal class="mt-12 flex gap-4 items-start max-w-3xl">
        <Doodle name="arrow" class="hidden sm:block w-24 shrink-0 text-ink mt-1" rotate={8} />
        <p class="text-lg leading-relaxed">
          We believe that the best way to ensure the long-term success of AI initiatives is to empower organizations to own their AI journey. That's why we emphasize training and citizen development at every stage.
        </p>
      </div>
    </div>
  </section>

  <!-- ───────────── Always Here ───────────── -->
  <section class="py-20 sm:py-28">
    <div class="max-w-5xl mx-auto px-5 sm:px-6">
      <p data-reveal class="text-sm font-semibold text-teal-dark">Always Here</p>
      <h2 data-reveal class="mt-2 text-4xl sm:text-5xl font-extrabold tracking-[-0.03em]">Our Unwavering Support</h2>
      <p data-reveal class="mt-4 font-hand text-3xl text-navy">We are always here for you.</p>

      <div class="mt-8 grid gap-6 md:grid-cols-2 text-lg leading-relaxed">
        <p data-reveal>We understand that even with the best training, questions and issues can arise. That's why The Public Service Desk is committed to providing ongoing support to address your future questions and issues.</p>
        <p data-reveal>Whether you need help troubleshooting a problem, want to explore new ways to use your AI tools, or require guidance on updates and maintenance, our team of experts is just a phone call or email away. We're your long-term partner, dedicated to ensuring your continued success with AI.</p>
      </div>

      <ul class="mt-12 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
        {support.map((item) => (
          <li data-reveal class="flex flex-col gap-3">
            <span class="grid place-items-center w-10 h-10 rounded-lg bg-teal-wash text-teal-dark">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={item.icon} /></svg>
            </span>
            <span class="font-semibold text-ink">{item.title}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ───────────── Citizen development ───────────── -->
  <section class="pb-20 sm:pb-28">
    <div class="max-w-5xl mx-auto px-5 sm:px-6">
      <div data-reveal class="card-glow relative rounded-3xl p-8 sm:p-12 overflow-hidden">
        <Doodle name="plane" class="absolute right-8 top-8 w-20 text-ink hidden md:block" rotate={-4} />
        <p class="text-sm font-semibold text-teal-dark">Citizen Development</p>
        <h2 class="mt-2 max-w-2xl text-3xl sm:text-4xl font-extrabold tracking-[-0.03em] leading-tight">
          Empowering Organizations Through Training and Citizen Development
        </h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed">
          Citizen development is an integral part of our mission. We equip your team with the skills and confidence to build, adapt, and sustain AI tools independently — long after our engagement ends. Join our email list for upcoming news.
        </p>
        <a href="#contact" class="mt-7 inline-flex items-center gap-2 rounded-lg bg-teal hover:bg-teal-dark text-ink hover:text-white font-semibold px-5 py-3 transition-colors">
          Join
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ───────────── Who We Are ───────────── -->
  <section id="who-we-are" class="py-20 sm:py-28 bg-wash border-y border-line">
    <div class="max-w-5xl mx-auto px-5 sm:px-6">
      <p data-reveal class="text-sm font-semibold text-teal-dark">Who We Are</p>
      <h2 data-reveal class="mt-2 text-4xl sm:text-5xl font-extrabold tracking-[-0.03em]">The people behind the <Squiggle>mission</Squiggle></h2>

      <div class="mt-12 grid gap-5 md:grid-cols-[1fr_1fr_0.9fr]">
        <article data-reveal class="rounded-2xl border border-line bg-white p-7">
          <Doodle name="smile" class="w-11 text-ink" />
          <h3 class="mt-4 text-xl font-bold tracking-tight">Our Story</h3>
          <p class="mt-3 leading-relaxed">At The Public Service Desk, we started as a small team of IT enthusiasts who wanted to help small organizations overcome their technology challenges.</p>
        </article>
        <article data-reveal class="rounded-2xl border border-line bg-white p-7 flex flex-col">
          <Doodle name="heart" class="w-11 text-ink" />
          <h3 class="mt-4 text-xl font-bold tracking-tight">Our Team</h3>
          <p class="mt-3 leading-relaxed">Our team of IT professionals is dedicated to providing exceptional service and support to our clients. Learn more about the mind behind the mission.</p>
          <a href="https://www.linkedin.com/company/the-public-service-desk/" target="_blank" rel="noopener noreferrer" class="mt-auto pt-5 inline-flex items-center gap-1.5 font-semibold text-navy hover:text-teal-dark">
            Connect on LinkedIn
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9" /></svg>
          </a>
        </article>
        <div data-reveal class="rounded-2xl overflow-hidden border border-line min-h-56">
          <img src="/images/hero-700x500.jpg" alt="Community members working together" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────── Contact ───────────── -->
  <section id="contact" class="relative py-20 sm:py-28">
    <Doodle name="bubble" label="hi!" class="absolute right-[6%] top-16 w-24 text-ink hidden lg:block" rotate={8} />
    <div class="max-w-5xl mx-auto px-5 sm:px-6 grid gap-12 lg:grid-cols-[1fr_1.2fr]">
      <div>
        <p data-reveal class="text-sm font-semibold text-teal-dark">Get in Touch</p>
        <h2 data-reveal class="mt-2 text-4xl sm:text-5xl font-extrabold tracking-[-0.03em]"><Squiggle>Contact Us</Squiggle></h2>
        <p data-reveal class="mt-5 font-hand text-3xl text-navy">Drop us a line!</p>

        <ul class="mt-8 space-y-4">
          <li data-reveal class="flex gap-3">
            <span class="grid place-items-center w-9 h-9 shrink-0 rounded-lg bg-teal-wash text-teal-dark">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" /><circle cx="12" cy="10" r="3" /></svg>
            </span>
            <span><span class="font-semibold text-ink">Address:</span> 5930 Middle Fiskville Road, Austin, TX 78752</span>
