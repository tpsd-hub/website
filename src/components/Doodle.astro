---
// Original hand-drawn ink doodles used as decoration around sections.
interface Props {
  name: 'bubble' | 'bulb' | 'wrench' | 'heart' | 'plane' | 'sparkle' | 'gear' | 'smile' | 'loop' | 'arrow' | 'dash';
  class?: string;
  label?: string;
  rotate?: number;
}

const { name, class: className = '', label, rotate = 0 } = Astro.props;
const ink = { fill: 'none', stroke: 'currentColor', 'stroke-width': 2.2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---

<svg
  class:list={['doodle pointer-events-none select-none', className]}
  style={`--r:${rotate}deg`}
  aria-hidden="true"
  viewBox={name === 'loop' ? '0 0 260 220' : name === 'arrow' ? '0 0 140 80' : '0 0 100 100'}
>
  {name === 'bubble' && (
    <g {...ink}>
      <path d="M18 22c10-12 54-14 66-2 10 10 8 32-4 40-10 7-30 8-42 6l-16 14 4-18c-12-8-16-28-8-40z" />
      <text x="51" y="47" text-anchor="middle" font-family="Caveat, cursive" font-size="26" fill="currentColor" stroke="none">{label ?? 'hi!'}</text>
    </g>
  )}
  {name === 'bulb' && (
    <g {...ink}>
      <path d="M50 22c-14 0-24 10-23 24 1 10 8 15 11 22 1 3 1 6 1 8h22c0-2 0-5 1-8 3-7 10-12 11-22 1-14-9-24-23-24z" />
      <path d="M40 82h20M42 89h16M44 58c3-6 9-6 12 0" />
      <path d="M50 6v7M20 16l5 5M80 16l-5 5M10 44h7M83 44h7" class="text-teal" stroke="var(--color-teal)" />
    </g>
  )}
  {name === 'wrench' && (
    <g {...ink}>
      <path d="M70 12c-10-3-21 4-21 15 0 3 1 5 2 7L16 69c-4 4-4 10 0 13s9 4 13 0l35-35c2 1 4 2 7 2 11 0 18-11 15-21l-10 10-9-2-2-9 10-10z" />
      <circle cx="22" cy="76" r="2.5" />
    </g>
  )}
  {name === 'heart' && (
    <g {...ink}>
      <path d="M50 84C26 66 12 52 14 34c2-14 18-20 28-12 4 3 6 7 8 10 2-3 4-7 8-10 10-8 26-2 28 12 2 18-12 32-36 50z" />
      <path d="M30 34c2-5 6-7 10-6" stroke="var(--color-teal)" />
    </g>
  )}
  {name === 'plane' && (
    <g {...ink}>
      <path d="M90 12L10 44l26 10 6 26 14-18 20 12z" />
      <path d="M36 54l54-42M42 80l6-20" />
    </g>
  )}
  {name === 'sparkle' && (
    <g {...ink} stroke="var(--color-teal)">
      <path d="M50 10c3 22 10 32 34 40-24 6-31 16-34 40-4-24-11-34-34-40 23-8 30-18 34-40z" />
    </g>
  )}
  {name === 'gear' && (
    <g {...ink}>
      <path d="M44 10h12l2 11 9 4 9-7 9 9-7 9 4 9 11 2v12l-11 2-4 9 7 9-9 9-9-7-9 4-2 11H44l-2-11-9-4-9 7-9-9 7-9-4-9-11-2V44l11-2 4-9-7-9 9-9 9 7 9-4z" />
      <circle cx="50" cy="50" r="13" />
    </g>
  )}
  {name === 'smile' && (
    <g {...ink}>
      <path d="M50 12c22-1 38 15 38 37S72 88 50 88 12 72 12 50s16-37 38-38z" />
      <path d="M36 40v4M64 40v4M32 58c8 12 28 12 36 0" />
    </g>
  )}
  {name === 'loop' && (
    <g {...ink}>
      <path d="M130 30c48-2 92 30 90 80-2 46-46 82-92 80-48-2-88-38-88-82 0-28 14-52 38-66" />
      <path d="M66 30l14 12-18 6" />
      <path d="M128 64c-24 0-42 20-40 44 2 22 20 38 42 38s40-18 40-40" stroke="var(--color-teal)" />
      <path d="M160 106l10 0 2-10" stroke="var(--color-teal)" />
      <path d="M118 104l8 9 16-20" />
    </g>
  )}
  {name === 'arrow' && (
    <g {...ink}>
      <path d="M6 14c30-6 70 4 100 40" />
      <path d="M92 58l16-2-4-16" />
    </g>
  )}
  {name === 'dash' && (
    <g {...ink} stroke-width="4" stroke="var(--color-teal)">
      <path d="M30 70l40-40" />
    </g>
  )}
</svg>
