---
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-wash">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 py-14 grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
    <div>
      <a href="#top" class="flex items-center gap-2.5">
        <img src="/images/7a479df6e68f0eabf2b4b4f904abea4c.jpg" alt="" class="w-8 h-8 rounded-md object-contain" />
        <span class="font-bold tracking-tight text-ink">The Public Service Desk</span>
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-subtle">
        Partnering with nonprofits and community organizations to build, implement, and maintain impactful AI applications.
      </p>
      <a href="https://www.linkedin.com/company/the-public-service-desk/" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-navy hover:text-teal-dark">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.1c0-1.22-.02-2.78-1.7-2.78-1.7 0-1.95 1.32-1.95 2.69V21h-4z" /></svg>
        LinkedIn
      </a>
    </div>
    <div>
      <h3 class="text-sm font-semibold">Quick Links</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-subtle">
        <li><a href="#what-we-do" class="hover:text-ink">What We Do</a></li>
        <li><a href="#beyond-the-build" class="hover:text-ink">Beyond the Build</a></li>
        <li><a href="#process" class="hover:text-ink">Process</a></li>
        <li><a href="#contact" class="hover:text-ink">Contact Us</a></li>
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-semibold">Find Us</h3>
      <address class="mt-4 not-italic text-sm leading-relaxed text-subtle">
        5930 Middle Fiskville Road<br />Austin, TX 78752
      </address>
      <p class="mt-2.5 text-sm text-subtle">Open today 09:00 am – 05:00 pm</p>
    </div>
  </div>
  <div class="border-t border-line">
    <p class="max-w-6xl mx-auto px-5 sm:px-6 py-6 text-xs text-subtle">© {year} The Public Service Desk - All Rights Reserved.</p>
  </div>
</footer>
